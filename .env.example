# Oremi Iṣakoso Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the OREMI_ISAKOSO_ prefix.
# ============================================================

# -- Server Settings -------------------------------------------------------------
# Host address to bind the server to. Use 0.0.0.0 to listen on all interfaces.
OREMI_ISAKOSO_SERVER_HOST=localhost

# Port number to bind the server to. Must be between 1 and 65535.
OREMI_ISAKOSO_SERVER_PORT=5089

# API prefix/root path for deployments behind a reverse proxy.
OREMI_ISAKOSO_API_PREFIX=/

# -- MQTT Settings ---------------------------------------------------------------
# MQTT is optional. Set OREMI_ISAKOSO_MQTT_BROKER to enable MQTT.

# MQTT broker hostname or IP address. If not set, MQTT is disabled.
OREMI_ISAKOSO_MQTT_BROKER=test.mosquitto.org

# MQTT broker port. Must be between 1 and 65535.
OREMI_ISAKOSO_MQTT_PORT=1883

# Base Zigbee2MQTT topic. A trailing slash is added automatically.
OREMI_ISAKOSO_ZIGBEE2MQTT_TOPIC_PREFIX=zigbee2mqtt/

# MQTT client identifier. If not set, auto-generated from hostname and process ID.
OREMI_ISAKOSO_MQTT_CLIENT_ID=oremi-isakoso-1

# MQTT broker username/password. Optional.
# OREMI_ISAKOSO_MQTT_USERNAME=
# OREMI_ISAKOSO_MQTT_PASSWORD=

# MQTT keepalive interval in seconds. Must be at least 10.
OREMI_ISAKOSO_MQTT_KEEPALIVE=60

# Enable TLS/SSL for MQTT connection.
OREMI_ISAKOSO_MQTT_TLS_ENABLED=false

# Path to CA certificate file for MQTT TLS verification.
# OREMI_ISAKOSO_MQTT_TLS_CA_CERT=/path/to/ca.crt

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
OREMI_ISAKOSO_LOG_LEVEL=INFO

# Path to log file. Leave unset to use the default configured by Settings.
# OREMI_ISAKOSO_LOG_FILE=/var/log/oremi-isakoso.log
