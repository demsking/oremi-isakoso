{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "isakoso:app",
        "--reload",
        "--reload-dir",
        "isakoso",
        "--host",
        "0.0.0.0",
        "--port",
        "5089"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "env": {
        "OREMI_ISAKOSO_LOG_LEVEL": "DEBUG",
        "OREMI_ISAKOSO_MQTT_BROKER": "ngaoundere",
        "OREMI_ISAKOSO_MQTT_PORT": "51883"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
